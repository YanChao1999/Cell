          "max": 1,
          "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 8, "spanNulls": true }
        }
      },
      "targets": [
        {
          "expr": "cell_worker_cpu_ratio{worker=\"worker-b\"}",
          "legendFormat": "cpu",
          "refId": "A"
        },
        {
          "expr": "cell_worker_memory_used_bytes{worker=\"worker-b\"} / clamp_min(cell_worker_memory_total_bytes{worker=\"worker-b\"}, 1)",
          "legendFormat": "mem",
          "refId": "B"
        },
        {
          "expr": "cell_worker_disk_used_bytes{worker=\"worker-b\"} / clamp_min(cell_worker_disk_total_bytes{worker=\"worker-b\"}, 1)",
          "legendFormat": "disk",
          "refId": "C"
        }
      ]
    }
  ],
